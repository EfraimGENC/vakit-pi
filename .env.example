# ============================================================
# Vakit-Pi — Örnek Ortam Değişkenleri (MOCK / ŞABLON)
# ============================================================
# Bu dosya yalnızca ÖRNEK (mock) değerler içerir ve repoya
# commit'lenebilir. Gerçek/kişisel değerlerinizi kullanmak için:
#
#     cp .env.example .env      # sonra .env dosyasını düzenleyin
#
# `.env` dosyası .gitignore ile hariç tutulur; ASLA commit EDİLMEZ.
# Konum, cihaz MAC adresi, sunucu adı gibi kişisel/hassas bilgileri
# YALNIZCA yerel `.env` veya ~/.config/vakit-pi/settings.json içinde
# tutun; kaynak kodda ya da dokümantasyonda paylaşmayın.
# ------------------------------------------------------------

# --- Sunucu ---
# Yalnızca yerel ağa açmak için 0.0.0.0; sadece bu makineden
# erişim için 127.0.0.1 kullanın (daha güvenli).
VAKIT_PI_HOST=127.0.0.1
VAKIT_PI_PORT=8080
VAKIT_PI_LOG_LEVEL=INFO

# --- Dosya yolları (opsiyonel; boş bırakılırsa varsayılanlar kullanılır) ---
# VAKIT_PI_SETTINGS_PATH=~/.config/vakit-pi/settings.json
# VAKIT_PI_AUDIO_DIR=src/vakit_pi/assets/audio
# VAKIT_PI_STATIC_DIR=src/vakit_pi/web

# --- Konum (MOCK: İstanbul şehir merkezi placeholder'ı) ---
# Gerçek ev/mescit konumunuzu buraya koyup commit ETMEYİN.
# İlk çalıştırmada settings.json yoksa bu değerler varsayılan olur.
VAKIT_PI_LAT=41.0082
VAKIT_PI_LNG=28.9784
VAKIT_PI_CITY=İstanbul

# --- Bluetooth hoparlör (MOCK MAC) ---
# Kendi cihazınızın MAC adresiyle değiştirin: `bluetoothctl devices`
# XX:XX:... placeholder değeri "MAC yok" olarak yorumlanır.
VAKIT_PI_BT_MAC=XX:XX:XX:XX:XX:XX

# --- Dağıtım / SSH (MOCK) — sadece deploy script'leri ve dokümanlar için ---
# Raspberry Pi kullanıcı adı ve host/IP bilgisi. Gerçek iç IP'nizi
# repoya yazmayın; yalnızca yerel .env içinde tutun.
VAKIT_PI_DEPLOY_USER=pi
VAKIT_PI_DEPLOY_HOST=raspberrypi.local
